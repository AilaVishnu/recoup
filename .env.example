# Razorpay TEST MODE keys only. Dashboard -> Settings -> API Keys (with Test Mode toggled on).
# Test keys always start with rzp_test_. If yours starts with rzp_live_, STOP - wrong mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for the agent decision layer.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Simulation controls (see recoup/config.py for what each one does) ---
RECOUP_DB_URL=sqlite:///data/recoup.db
RECOUP_SEED=42
RECOUP_DRY_RUN=false

# --- Decision model ------------------------------------------------------
# Which provider answers the ~20% of events the taxonomy cannot settle alone.
# The policy engine never learns which one it was: a proposal from a frontier
# model and one from a free tier clear the same thirteen bounds or neither does.
#
#   anthropic  (default) - uses ANTHROPIC_API_KEY
#   openai               - ANY OpenAI-compatible /chat/completions endpoint
#
# Free options that need no credit card, with the base URL to use:
#
#   Google Gemini   https://generativelanguage.googleapis.com/v1beta/openai/
#                   model: gemini-2.0-flash        key: aistudio.google.com
#   Groq            https://api.groq.com/openai/v1
#                   model: llama-3.3-70b-versatile key: console.groq.com
#   OpenRouter      https://openrouter.ai/api/v1
#                   model: <any :free model>       key: openrouter.ai
#
# OpenAI itself has no free tier - it needs prepaid credit. If you have a key
# with credit, leave RECOUP_LLM_BASE_URL blank and set the model to gpt-4o-mini.
RECOUP_LLM_PROVIDER=
RECOUP_LLM_BASE_URL=
RECOUP_LLM_MODEL=
OPENAI_API_KEY=
