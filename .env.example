# =========================================================================
#  Recoup - local environment.  Copy to .env and fill in what you have.
#
#  Every value below is BLANK on purpose. Recoup runs end to end with none of
#  them set - it seeds, decides, reviews, simulates execution and grades itself
#  offline. Keys upgrade it from simulated execution to real Razorpay calls and
#  from taxonomy-only decisions to model-assisted ones; they do not gate it.
#
#  Blank rather than placeholder is a deliberate choice. A dummy value like
#  rzp_test_xxxxxxxx is indistinguishable from a real key to the code, so the
#  setup check reports "rejected" instead of "absent", every gateway call fails
#  against credentials that were never meant to work, and a first run produces a
#  negative headline result caused entirely by the example file.
# =========================================================================

# --- Razorpay ------------------------------------------------------------
# Test mode only. config.py refuses to start on a rzp_live_ key.
# dashboard.razorpay.com -> Test Mode -> Account & Settings -> API Keys.
# The secret is shown ONCE at generation; if you miss it, regenerate the pair.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Decision model ------------------------------------------------------
# Which provider answers the ~20% of events the taxonomy cannot settle alone.
# The policy engine never learns which one it was: a proposal from a frontier
# model and one from a free tier clear the same thirteen bounds or neither does.
#
#   anthropic  (default) - uses ANTHROPIC_API_KEY
#   openai               - ANY OpenAI-compatible /chat/completions endpoint
#
# Free options that need no credit card:
#
#   Google Gemini   RECOUP_LLM_PROVIDER=openai
#                   RECOUP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                   RECOUP_LLM_MODEL=gemini-flash-lite-latest
#                   key: aistudio.google.com
#                   NOTE: pick a *-lite model. The full flash models carry a
#                   free quota of about 20 requests, which one pipeline run
#                   exhausts in its first minute; the lite tier is far larger.
#                   Model ids move - if you get a 404, the error body names
#                   the current replacement, or GET <base_url>/models lists them.
#
#   Groq            RECOUP_LLM_PROVIDER=openai
#                   RECOUP_LLM_BASE_URL=https://api.groq.com/openai/v1
#                   RECOUP_LLM_MODEL=llama-3.3-70b-versatile
#                   key: console.groq.com
#
#   OpenRouter      RECOUP_LLM_PROVIDER=openai
#                   RECOUP_LLM_BASE_URL=https://openrouter.ai/api/v1
#                   RECOUP_LLM_MODEL=<any model ending in :free>
#                   key: openrouter.ai
#
# OpenAI itself has no free tier - it needs prepaid credit. With a funded key,
# leave RECOUP_LLM_BASE_URL blank and set RECOUP_LLM_MODEL=gpt-4o-mini.
RECOUP_LLM_PROVIDER=
RECOUP_LLM_BASE_URL=
RECOUP_LLM_MODEL=
# Client-side pacing, in requests per minute. 0 = unpaced.
# Free tiers rate-limit per minute and a batch run fires as fast as it can. On a
# first live run against Gemini's free tier, 140 of 161 escalated events came
# back 429 and fell back to the taxonomy - every event still got a decision, but
# the model answered 21 of them. 10 is a safe value for most free tiers.
RECOUP_LLM_RPM=10
# The key for whichever provider you chose above. Provider-neutral on
# purpose: OPENAI_API_KEY is a wire-protocol name, not a vendor name, and
# asking someone to paste a Google key into it is friction the project
# put there. The vendor-specific names below still work.
RECOUP_LLM_API_KEY=

# Accepted as fallbacks if RECOUP_LLM_API_KEY is empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Runtime -------------------------------------------------------------
RECOUP_DB_URL=sqlite:///data/recoup.db

# Fixes the synthetic dataset and the frozen outcome rolls. Change it to test
# whether a result holds on different data; keep it to reproduce a report exactly.
RECOUP_SEED=42

# true  = executors log intended Razorpay calls instead of making them.
# false = real Payment Links get created in your TEST account.
#
# Defaults to true. A full run touches hundreds of events, and you want to read
# what it INTENDED to do before it does it for real. Flip to false once a dry run
# looks right - ideally just before recording a demo, so the dashboard shows
# genuine Razorpay link ids rather than obvious plink_dry_* fakes.
RECOUP_DRY_RUN=true
